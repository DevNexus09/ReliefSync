<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.reliefsync.controller.LoginController"
            styleClass="app-background">
    <center>
        <VBox alignment="CENTER" maxWidth="430" spacing="18" styleClass="auth-card">
            <padding>
                <Insets bottom="42" left="42" right="42" top="42" />
            </padding>
            <Label styleClass="brand-title" text="ReliefSync" />
            <Label styleClass="screen-subtitle"
                   text="Intelligent Disaster Relief Resource Coordination System"
                   wrapText="true" />
            <TextField fx:id="usernameField" accessibleText="Username" promptText="Username" />
            <PasswordField fx:id="passwordField" accessibleText="Password" promptText="Password" />
            <Button defaultButton="true"
                    maxWidth="Infinity"
                    onAction="#handleLogin"
                    styleClass="primary-button"
                    text="Sign In" />
            <Label fx:id="errorLabel" styleClass="form-error" wrapText="true" />
            <Label styleClass="phase-note"
                   text="Demo data is available only when RELIEFSYNC_SEED_DEMO=true."
                   wrapText="true" />
        </VBox>
    </center>
</BorderPane>
