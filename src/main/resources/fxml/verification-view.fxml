<?import javafx.geometry.Insets?><?import javafx.scene.control.*?><?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.reliefsync.controller.VerificationController" styleClass="app-background"><top><HBox alignment="CENTER_LEFT" styleClass="top-bar"><padding><Insets top="16" right="24" bottom="16" left="24"/></padding><Label text="Verification Queue" styleClass="brand-mark"/><Region HBox.hgrow="ALWAYS"/><Button text="Refresh" onAction="#refresh" styleClass="secondary-button"/><Button text="Dashboard" onAction="#back" styleClass="secondary-button"/></HBox></top><center><SplitPane dividerPositions="0.48"><VBox spacing="10"><padding><Insets top="18" right="12" bottom="18" left="18"/></padding><Label text="Requests requiring your verification" styleClass="session-detail"/><TableView fx:id="table" VBox.vgrow="ALWAYS"/></VBox><VBox spacing="10"><padding><Insets top="18" right="18" bottom="18" left="12"/></padding><Label text="Request Details" styleClass="session-detail"/><TextArea fx:id="detailsArea" editable="false" wrapText="true" VBox.vgrow="ALWAYS"/><Label text="Decision reason (required for return/reject)"/><TextArea fx:id="reasonArea" prefRowCount="3" wrapText="true"/><HBox spacing="10"><Button text="Approve" onAction="#approve" styleClass="primary-button"/><Button text="Return for Correction" onAction="#returnRequest"/><Button text="Reject" onAction="#reject"/><Button text="Full History" onAction="#history"/></HBox></VBox></SplitPane></center></BorderPane>
