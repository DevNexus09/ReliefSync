<?import javafx.geometry.Insets?><?import javafx.scene.control.*?><?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.reliefsync.controller.InventoryController" styleClass="app-background"><top><HBox alignment="CENTER_LEFT" styleClass="top-bar"><padding><Insets top="16" right="24" bottom="16" left="24"/></padding><Label text="Inventory" styleClass="brand-mark"/><Region HBox.hgrow="ALWAYS"/><Button text="Dashboard" onAction="#back" styleClass="secondary-button"/></HBox></top><center><VBox spacing="14"><padding><Insets top="22" right="24" bottom="22" left="24"/></padding><HBox spacing="10"><TextField fx:id="centerFilter" promptText="Center ID" prefWidth="90"/><TextField fx:id="resourceFilter" promptText="Resource ID" prefWidth="100"/><TextField fx:id="searchField" promptText="Resource category..." HBox.hgrow="ALWAYS"/><Button text="Search" onAction="#search" styleClass="primary-button"/><Button text="Low Stock Only" onAction="#lowStock"/><Button text="Reset" onAction="#reset"/></HBox><TableView fx:id="table" VBox.vgrow="ALWAYS"/><Label text="Reserved, dispatched, and available quantities are workflow-controlled and read-only." styleClass="phase-note"/><HBox fx:id="writeActions" spacing="10"><Button text="Initialize Stock" onAction="#initializeStock" styleClass="primary-button"/><Button text="Adjust Total Stock" onAction="#adjust"/></HBox></VBox></center></BorderPane>
