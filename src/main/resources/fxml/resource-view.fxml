<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.reliefsync.controller.ResourceController" styleClass="app-background"><top><HBox alignment="CENTER_LEFT" styleClass="top-bar"><padding><Insets top="16" right="24" bottom="16" left="24"/></padding><Label text="Resources" styleClass="brand-mark"/><Region HBox.hgrow="ALWAYS"/><Button text="Dashboard" onAction="#back" styleClass="secondary-button"/></HBox></top><center><VBox spacing="14"><padding><Insets top="22" right="24" bottom="22" left="24"/></padding><HBox spacing="10"><TextField fx:id="searchField" promptText="Name contains..." HBox.hgrow="ALWAYS"/><TextField fx:id="categoryFilter" promptText="Category"/><ComboBox fx:id="activeFilter" promptText="Any status"/><Button text="Search" onAction="#search" styleClass="primary-button"/><Button text="Reset" onAction="#reset"/></HBox><TableView fx:id="table" VBox.vgrow="ALWAYS"/><HBox fx:id="writeActions" spacing="10"><Button text="New" onAction="#create" styleClass="primary-button"/><Button text="Edit" onAction="#edit"/><Button text="Activate" onAction="#activate"/><Button text="Deactivate" onAction="#deactivate"/></HBox></VBox></center></BorderPane>
